{
  "manifest_version": 3,
  "name": "Recent Reviews for Google Search & Maps",
  "version": "1.0.1",
  "description": "Shows a place's recent review averages (1, 3 and 6 months by default) next to Google's all-time rating on Search and Maps.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Recent Reviews for Google Search & Maps",
    "default_popup": "src/frameworks/popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/search*",
        "https://www.google.com/maps*",
        "https://www.google.co.uk/search*",
        "https://www.google.co.uk/maps*",
        "https://www.google.ca/search*",
        "https://www.google.ca/maps*",
        "https://www.google.com.au/search*",
        "https://www.google.com.au/maps*",
        "https://www.google.co.nz/search*",
        "https://www.google.co.nz/maps*",
        "https://www.google.ie/search*",
        "https://www.google.ie/maps*"
      ],
      "js": [
        "src/frameworks/content/loader.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/domain/entities/*.js",
        "src/domain/services/*.js",
        "src/usecases/*.js",
        "src/usecases/ports/*.js",
        "src/adapters/dao/*.js",
        "src/adapters/presenters/*.js",
        "src/frameworks/content/*.js",
        "src/frameworks/ui/*.js"
      ],
      "matches": [
        "https://www.google.com/*",
        "https://www.google.co.uk/*",
        "https://www.google.ca/*",
        "https://www.google.com.au/*",
        "https://www.google.co.nz/*",
        "https://www.google.ie/*"
      ]
    }
  ]
}
